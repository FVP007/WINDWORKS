#VRML V2.0 utf8

# Grupo principal do vento com animação
DEF Cadeia Transform {
  translation 0 0 0
  children [
    # Aplicando transparência ao modelo de vento
    Transform {
      children [
        # Incorporando o conteúdo do ventos.wrl
        Inline { url ":ventos.wrl" }
      ]
    }
  ]
}

# Material transparente para o vento
DEF VENTO_MATERIAL Material {
  diffuseColor 0.6 0.6 0.6
  emissiveColor 0.2 0.2 0.2
  transparency 0.9
  shininess 0.1
}

# Controlador do tempo
DEF Tempo TimeSensor {
  cycleInterval 2
  loop TRUE
  startTime 0
}

# Movimento
DEF Mover PositionInterpolator {
  key [ 0, 1 ]
  keyValue [ 0 0 0, -25060 0 0 ]
}

# Conexões
ROUTE Tempo.fraction_changed TO Mover.set_fraction
ROUTE Mover.value_changed TO Cadeia.set_translation
